+// Nested spans share the bind invocation; their durations overlap their parent.
+class BindDetailSpan {
+public:
+    BindDetailSpan(const char *name, int32_t depth) :
+        name_(name),
+        depth_(depth) {
+        if (!host_phase_breakdown_enabled() || !unified_log_host_span_enabled()) return;
+        const auto *state = unified_log_host_trace_state();
+        if (state == nullptr || state->inv == 0) return;
+        state_ = *state;
+        start_ns_ = bind_now_ns();
+    }
+
+    ~BindDetailSpan() {
+        if (start_ns_ == 0) return;
+        const SimplerHostSpan span{state_.inv, state_.hid, depth_, 0, start_ns_, bind_now_ns() - start_ns_, name_, ""};
+        unified_log_host_span(&span);
+    }
+
+    BindDetailSpan(const BindDetailSpan &) = delete;
+    BindDetailSpan &operator=(const BindDetailSpan &) = delete;
+
+private:
+    const char *name_;
+    int32_t depth_;
+    SimplerHostTraceState state_{};
+    int64_t start_ns_{0};
+};
